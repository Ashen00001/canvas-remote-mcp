# Copy to .env for local testing. NEVER commit the real .env.
# In production these are set as host secrets (fly secrets set / Railway vars),
# not as a file.

# --- Canvas ---
# NOTE: Canvas personal access tokens are FULL ACCESS (equivalent to your
# password). Scoped tokens require institution-admin developer keys.
CANVAS_API_TOKEN=19324~replace_me
CANVAS_BASE_URL=https://yourschool.instructure.com

# --- Public URL of this server (no trailing slash) ---
# Must match the GitHub OAuth App's base; used to build the callback URL.
BASE_URL=https://your-app-name.fly.dev

# --- GitHub OAuth App ---
# Create at: https://github.com/settings/developers -> New OAuth App
# Authorization callback URL MUST be: <BASE_URL>/auth/callback
GITHUB_CLIENT_ID=replace_me
GITHUB_CLIENT_SECRET=replace_me

# --- Allowlist (comma-separated GitHub usernames) ---
# Server refuses to boot if this is empty.
ALLOWED_GITHUB_USERS=Ashen00001
